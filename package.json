{
  "name": "hill-duel",
  "version": "0.1.0",
  "private": true,
  "description": "雙人線上回合制砲擊對戰（Phaser + Socket.IO + Node.js）",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:vite": "vite build"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1",
    "typescript": "5.7.2",
    "@types/node": "22.10.2"
  },
  "devDependencies": {
    "concurrently": "9.1.0",
    "vite": "6.0.7",
    "tsx": "4.19.2"
  },
  "engines": {
    "node": ">=20"
  }
}
